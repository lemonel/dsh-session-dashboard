{
  "name": "@hsx/dsh-session-dashboard",
  "version": "0.7.0",
  "description": "Organize DSH sessions by project, with shared tags, custom work statuses and execution-bound human review.",
  "repository": { "type": "git", "url": "git+https://github.com/lemonel/dsh-session-dashboard.git" },
  "homepage": "https://github.com/lemonel/dsh-session-dashboard#readme",
  "bugs": { "url": "https://github.com/lemonel/dsh-session-dashboard/issues" },
  "keywords": ["dsh", "dsh-plugin", "session-dashboard", "projects", "tags", "review"],
  "author": "lemonel",
  "type": "module",
  "main": "./lib/backend_index.js",
  "types": "./lib/backend_index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/backend_index.d.ts",
      "default": "./lib/backend_index.js"
    },
    "./api": {
      "types": "./lib/shared/public_api.d.ts",
      "default": "./lib/shared/public_api.js"
    },
    "./slots": {
      "types": "./lib/frontend/public_slots.d.ts",
      "default": "./lib/frontend/public_slots.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/backend/typert.host.js",
    "./remote": "./lib/frontend/typert.remote-client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./bundles/locale/en.json",
    "./locale/zh.json": "./bundles/locale/zh.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "bundles",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/EXTENSION-API.md",
    "docs/EXTENSIONS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundles/session-dashboard.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": []
    },
    "engines": {
      "dsh": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node test/tools/browser-suite.mjs",
    "check:package": "node test/tools/check-package.mjs",
    "verify:clean": "node test/tools/verify-clean.mjs",
    "verify:install": "node test/tools/verify-install.mjs",
    "prepack": "npm run build",
    "test:matrix": "node test/tools/matrix.mjs",
    "test:surface": "node test/tools/host-surface.mjs --host-root node_modules"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5 || >=4.0.5-alpha.1 <4.0.6-0",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-alpha.3 || 0.2.1-alpha.4 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
